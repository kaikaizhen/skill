# ---------------------------------------------------------------------------
# Organization workspace - NEVER published.
# Everything under workspace/ is organization-specific knowledge: architecture,
# repository memory, business rules, corrections, unknowns, org-only tooling.
# Only the empty skeleton (force-added .gitkeep files, PROFILE.example.md and
# runtime.example.yaml) is tracked, so a fresh clone has the directories and the
# descriptor shapes it needs. The filled-in PROFILE.md and runtime.yaml are not.
# ---------------------------------------------------------------------------
enterprise-codebase-analysis/workspace/

# Belt and braces: machine-local secrets never leave this machine, even if the
# workspace rule above is ever relaxed. Values are DPAPI-encrypted; the directory
# itself is never tracked.
**/.secrets/
!**/.secrets/.gitkeep
*.secret


# Per-ticket output never belongs in the engine repo either
issue/
temp/

# Local noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
